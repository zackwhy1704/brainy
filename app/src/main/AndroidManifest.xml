<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SecondBrainApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SecondBrain"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SecondBrain">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!--
          OverlaySpikeService (Phase 1(d) Door 3 platform-risk spike) and the three permissions
          it alone needs (SYSTEM_ALERT_WINDOW, FOREGROUND_SERVICE_SPECIAL_USE, POST_NOTIFICATIONS
          — plus plain FOREGROUND_SERVICE, needed to start any foreground service and, like the
          other three, unused by anything else in this app) live in src/debug/AndroidManifest.xml,
          not here. Door 3 is "first thing to cut under pressure" (ARCHITECTURE.md); a release
          build has no reachable path to this service (nothing in shipped code starts it) and
          should not declare permissions for a feature it doesn't ship. See that file for the
          service declaration and the exported=false testing note.
        -->
    </application>

</manifest>
